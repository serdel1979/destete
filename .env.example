# Copiar este archivo a .env antes de levantar el proyecto.
# docker-compose.yml carga automáticamente el .env de esta carpeta.

POSTGRES_USER=destete
POSTGRES_PASSWORD=destete
POSTGRES_DB=destete
POSTGRES_HOST=db
POSTGRES_PORT=5432

SECRET_KEY=cambiar-esta-clave-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=720

ADMIN_EMAIL=admin@destete.com
ADMIN_PASSWORD=admin123

# Puerto en el que se expone la API en el host
API_PORT=8000
# Puerto en el que se expone el frontend en el host
FRONTEND_PORT=4200
# Puerto de Postgres expuesto en el host (útil para conectar un cliente SQL)
# 5433 por defecto para no chocar con un Postgres local en 5432
DB_PORT=5433
